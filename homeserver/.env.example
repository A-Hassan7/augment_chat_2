# ============================================================================
# Homeserver Configuration
# ============================================================================
# Single .env file for all homeserver services
# Copy this to .env and fill in your values
# ============================================================================

# ========================================
# Homeserver Identity
# ========================================
HOMESERVER_ID=hs-001
HOMESERVER_NAME=matrix.example.com
HOMESERVER_URL=http://localhost:8008
HOMESERVER_HS_TOKEN=your_homeserver_token_here

# ========================================
# Bridge Manager Appservice
# ========================================
BRIDGE_MANAGER_INSTANCE_ID=bm-001
BRIDGE_MANAGER_HOST=0.0.0.0
BRIDGE_MANAGER_PORT=5001
BRIDGE_MANAGER_AS_TOKEN=your_application_service_token_here

# Bridge Manager hostname for containers to reach appservice
# Docker Desktop (Mac/Windows): host.docker.internal
# Linux: Use actual IP or hostname
BRIDGE_MANAGER_HOSTNAME=host.docker.internal

# Host used by the bridge manager to reach bridge containers.
# Set to "host.docker.internal" when bridge manager runs inside Docker
# (required when using --bridge-managers with deploy.py).
# Leave as "localhost" when running bridge manager natively on the host.
BRIDGE_HOST=localhost

# ========================================
# Database
# ========================================
# Bridge Manager database
BRIDGE_MANAGER_DATABASE_URL=postgresql://bridge_user:bridge_pass@localhost:5432/bridge_manager

# Synapse database (for deployment/client)
SYNAPSE_DATABASE_URL=postgresql://synapse:password@localhost:5432/synapse

# ========================================
# Docker Configuration
# ========================================
DOCKER_HOST=unix:///var/run/docker.sock
BRIDGE_MANAGER_DOCKER_NETWORK=bridge_network

# ========================================
# Logging (Optional - have defaults)
# ========================================
BRIDGE_MANAGER_LOG_LEVEL=INFO
BRIDGE_MANAGER_LOG_REQUESTS=true

# ========================================
# Synapse Deployment (Optional)
# ========================================
SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=your_admin_password

# ========================================
# Bridge Images (Optional - have defaults)
# ========================================
WHATSAPP_BRIDGE_IMAGE=dock.mau.dev/mautrix/whatsapp:latest
TELEGRAM_BRIDGE_IMAGE=dock.mau.dev/mautrix/telegram:latest
